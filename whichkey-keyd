#!/usr/bin/env python3
"""whichkey-keyd -- watch every keyboard for modifier press/release and push the
current canonical modifier mask to the Omarchy shell's Which-Key overlay.

    hold Super            -> omarchy-shell -q whichkey mods "SUPER"
    add Shift             -> omarchy-shell -q whichkey mods "SUPER+SHIFT"
    release everything    -> omarchy-shell -q whichkey hide

The daemon only reads input; it never grabs a device, so normal keybindings are
unaffected. Reading /dev/input/event* requires membership in the 'input' group.
"""
import selectors
import signal
import subprocess
import sys
import threading
import time

try:
    from evdev import InputDevice, list_devices, ecodes as e
except ImportError:
    sys.exit("whichkey-keyd: python-evdev not installed "
             "(run: omarchy pkg add python-evdev)")

# --- config -----------------------------------------------------------------
SHOW_DELAY = 0.3    # seconds a chord must stay held before the HUD appears
SUPER_ONLY = True   # True: only show the HUD while Super is part of the chord
# --------------------------------------------------------------------------

MODCAT = {
    e.KEY_LEFTMETA: "SUPER",  e.KEY_RIGHTMETA: "SUPER",
    e.KEY_LEFTCTRL: "CTRL",   e.KEY_RIGHTCTRL: "CTRL",
    e.KEY_LEFTALT:  "ALT",    e.KEY_RIGHTALT:  "ALT",
    e.KEY_LEFTSHIFT: "SHIFT", e.KEY_RIGHTSHIFT: "SHIFT",
}
ORDER = ("SUPER", "CTRL", "ALT", "SHIFT")

held = set()          # modifier keycodes currently down
sent = None           # last mask string handed to the shell
show_timer = None


def current_mask():
    cats = {MODCAT[k] for k in held}
    return "+".join(m for m in ORDER if m in cats)


def call(*args):
    try:
        subprocess.run(("omarchy-shell", "-q", "whichkey", *args),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=1)
    except Exception:
        pass


def sync():
    global sent, show_timer
    mask = current_mask()
    if mask == sent:
        return
    sent = mask

    if show_timer:
        show_timer.cancel()
        show_timer = None

    visible = bool(mask) and (not SUPER_ONLY or "SUPER" in mask.split("+"))
    if not visible:
        call("hide")
        return

    # Debounce only the appearance, so a fast Super+K never flashes the HUD;
    # once it is up, adding/removing Shift updates it immediately.
    show_timer = threading.Timer(SHOW_DELAY, call, args=("mods", mask))
    show_timer.daemon = True
    show_timer.start()


RESCAN_SEC = 2.0    # how often to look for hotplugged / re-enumerated keyboards


def is_keyboard(dev):
    caps = dev.capabilities().get(e.EV_KEY, [])
    letters = sum(1 for k in range(e.KEY_Q, e.KEY_P + 1) if k in caps)
    return letters >= 8 and any(m in caps for m in MODCAT)


def scan(sel):
    """Register every readable keyboard not already watched. Returns the number
    of devices currently registered."""
    watched = {getattr(k.fileobj, "path", None) or getattr(k.fileobj, "fn", None)
               for k in sel.get_map().values()} if sel.get_map() else set()
    for path in list_devices():         # evdev only lists devices it can read
        if path in watched:
            continue
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if is_keyboard(dev):
            sel.register(dev, selectors.EVENT_READ)
        else:
            dev.close()
    return len(sel.get_map())


def drop(sel, dev):
    try:
        sel.unregister(dev)
        dev.close()
    except OSError:
        pass


def main():
    if not list_devices():
        sys.exit("whichkey-keyd: cannot read any /dev/input/event* -- your user "
                 "is not in the 'input' group yet, or you have not logged out "
                 "and back in since being added (a new terminal is not enough)")

    sel = selectors.DefaultSelector()
    if not scan(sel):
        sys.exit("whichkey-keyd: opened input devices but none look like a keyboard")

    def bye(*_):
        call("hide")
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    # Keyboards that re-enumerate to a new /dev/input/event* node (the AULA does
    # this on reconnect / mode switch) or are plugged in later are picked up by
    # the periodic rescan below -- no restart needed.
    last_scan = time.monotonic()
    spin_streak = 0   # consecutive near-instant, no-op select() iterations
    while True:
        if not sel.get_map():
            time.sleep(RESCAN_SEC)      # every keyboard went away; keep looking
            scan(sel)
            last_scan = time.monotonic()
            spin_streak = 0
            continue

        loop_start = time.monotonic()
        progressed = False   # did this iteration read/drop/change anything real?

        for key, _ in sel.select(timeout=RESCAN_SEC):
            try:
                events = list(key.fileobj.read())
            except OSError:
                # This node vanished (device unplugged or re-enumerating).
                drop(sel, key.fileobj)
                held.clear()             # don't leave a modifier stuck "held"
                sync()
                scan(sel)               # its replacement node is usually up now
                last_scan = time.monotonic()
                progressed = True
                continue
            if events:
                progressed = True
            changed = False
            for ev in events:
                if ev.type != e.EV_KEY or ev.code not in MODCAT:
                    continue
                if ev.value == 1:
                    held.add(ev.code)
                    changed = True
                elif ev.value == 0:
                    held.discard(ev.code)
                    changed = True
            if changed:
                sync()

        # Defense against a fd that selects ready over and over with nothing to
        # show for it (e.g. a keyboard stuck re-enumerating): if select() keeps
        # returning near-instantly with no reads/drops/changes, that's a busy
        # spin -- back off instead of burning a full core for minutes.
        if progressed or time.monotonic() - loop_start > 0.005:
            spin_streak = 0
        else:
            spin_streak += 1
            if spin_streak > 20:
                time.sleep(0.05)

        now = time.monotonic()
        if now - last_scan >= RESCAN_SEC:
            scan(sel)                   # catch a keyboard that appeared quietly
            last_scan = now


if __name__ == "__main__":
    main()
